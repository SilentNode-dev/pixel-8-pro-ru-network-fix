#!/system/bin/sh
# Pixel Russian Networks & 5G/VoLTE Fix - CLI Control & Diagnostic Utility
# Author: SilentNode-dev

MODDIR="/data/adb/modules/pixel_ru_network_fix"
[ -d "$MODDIR" ] || MODDIR="${0%/*/*}"

# Colors
GREEN="\033[1;32m"
RED="\033[1;31m"
YELLOW="\033[1;33m"
CYAN="\033[1;36m"
BOLD="\033[1m"
RESET="\033[0m"

print_header() {
    echo -e "${CYAN}======================================================${RESET}"
    echo -e "${BOLD} Pixel Network & 5G/VoLTE Fix (v1.0 Base) - Telemetry${RESET}"
    echo -e " Device: $(getprop ro.product.model) ($(getprop ro.product.device)) | Android: $(getprop ro.build.version.release)"
    echo -e "${CYAN}======================================================${RESET}"
}

check_modem_mounts() {
    echo -e "\n${BOLD}[ Modem Image & Baseband Bind-Mounts ]${RESET}"
    
    CFG_SRC="$MODDIR/confpack/cfg.db"
    UECAP_SRC="$MODDIR/uecap/WILDCARD.binarypb"
    
    MOUNTED_INODE=$(ls -i /mnt/vendor/modem_img/images/*/confpack/cfg.db 2>/dev/null | head -n 1 | awk '{print $1}')
    SRC_INODE=$(ls -i "$CFG_SRC" 2>/dev/null | awk '{print $1}')
    DONOR_INODE=$(ls -i /dev/.modem_donor/cfg.db 2>/dev/null | awk '{print $1}')
    if [ -n "$MOUNTED_INODE" ] && { [ "$SRC_INODE" = "$MOUNTED_INODE" ] || [ "$DONOR_INODE" = "$MOUNTED_INODE" ]; }; then
        echo -e " Baseband cfg.db:      ${GREEN}ACTIVE${RESET} (inode: $MOUNTED_INODE, Stealth SER Donor)"
    else
        echo -e " Baseband cfg.db:      ${RED}NOT MOUNTED${RESET}"
    fi

    UE_MOUNTED_INODE=$(ls -i /mnt/vendor/modem_img/images/*/uecap/WILDCARD.binarypb 2>/dev/null | head -n 1 | awk '{print $1}')
    UE_SRC_INODE=$(ls -i "$UECAP_SRC" 2>/dev/null | awk '{print $1}')
    UE_DONOR_INODE=$(ls -i /dev/.modem_donor/WILDCARD.binarypb 2>/dev/null | awk '{print $1}')
    if [ -n "$UE_MOUNTED_INODE" ] && { [ "$UE_SRC_INODE" = "$UE_MOUNTED_INODE" ] || [ "$UE_DONOR_INODE" = "$UE_MOUNTED_INODE" ]; }; then
        echo -e " Modem UE Capabilities:${GREEN}ACTIVE${RESET} (inode: $UE_MOUNTED_INODE, Stealth Wildcard CA/5G)"
    else
        echo -e " Modem UE Capabilities:${RED}NOT MOUNTED${RESET}"
    fi

    if grep -E "data/adb|pixel_ru_network_fix" /proc/self/mountinfo >/dev/null 2>&1; then
        echo -e " Banking Stealth:      ${YELLOW}LEAK DETECTED${RESET} (/proc/self/mountinfo)"
    else
        echo -e " Banking Stealth:      ${GREEN}PROTECTED${RESET} (Clean mountinfo, Mir Pay safe)"
    fi
}

check_telephony() {
    echo -e "\n${BOLD}[ Telephony & IMS Status ]${RESET}"
    
    OPERATORS=$(getprop gsm.sim.operator.alpha)
    NUMERICS=$(getprop gsm.sim.operator.numeric)
    NETWORKS=$(getprop gsm.network.type)

    OP1="${OPERATORS%%,*}"
    [ "$OP1" = "$OPERATORS" ] && OP2="" || OP2="${OPERATORS#*,}"
    PLMN1="${NUMERICS%%,*}"
    [ "$PLMN1" = "$NUMERICS" ] && PLMN2="" || PLMN2="${NUMERICS#*,}"
    NET1="${NETWORKS%%,*}"
    [ "$NET1" = "$NETWORKS" ] && NET2="" || NET2="${NETWORKS#*,}"

    [ -n "$OP1" ] && echo -e " SIM 1: ${BOLD}$OP1${RESET} (PLMN: $PLMN1 | Network: $NET1)"
    [ -n "$OP2" ] && echo -e " SIM 2: ${BOLD}$OP2${RESET} (PLMN: $PLMN2 | Network: $NET2)"
}

add_apn_if_missing() {
    APN_NAME="$1"
    NUMERIC="$2"
    APN_APN="$3"
    APN_TYPE="$4"

    MCC="${NUMERIC:0:3}"
    MNC="${NUMERIC:3}"

    EXISTING=$(content query --uri content://telephony/carriers --where "numeric='$NUMERIC' AND apn='$APN_APN'" 2>/dev/null)
    if [ -z "$EXISTING" ] || echo "$EXISTING" | grep -q "No result found"; then
        echo -e " Adding APN for ${CYAN}$APN_NAME${RESET} ($NUMERIC)..."
        content insert --uri content://telephony/carriers \
            --bind name:s:"$APN_NAME" \
            --bind numeric:s:"$NUMERIC" \
            --bind mcc:s:"$MCC" \
            --bind mnc:s:"$MNC" \
            --bind apn:s:"$APN_APN" \
            --bind type:s:"$APN_TYPE" \
            --bind protocol:s:"IPV4V6" \
            --bind roaming_protocol:s:"IPV4V6" \
            --bind bearer_bitmask:s:"0" \
            --bind user_editable:i:1 \
            --bind current:i:1 >/dev/null 2>&1
    fi
}

provision_apns() {
    echo -e "${CYAN}Checking certified Russian MVNO APNs...${RESET}"
    add_apn_if_missing "SberMobile" "25020" "sbermobile" "default,supl"
    add_apn_if_missing "T-Bank Internet" "25020" "m.tinkoff" "default,supl,dun"
    add_apn_if_missing "GPB Mobile" "25045" "internet.gpbm.ru" "default,supl"
    add_apn_if_missing "VTB Mobile" "25020" "internet.vtb.ru" "default,supl"
    add_apn_if_missing "Motiv Internet" "25035" "inet.ycc.ru" "default,supl"
    add_apn_if_missing "Letai Internet" "25027" "internet.letai.ru" "default,supl"
    add_apn_if_missing "T2 Internet" "25020" "internet.tele2.ru" "default,supl"
    echo -e "${GREEN}APN check complete.${RESET}"
}

reload_fix() {
    echo -e "${CYAN}Applying persistent telephony properties (Stealth mode)...${RESET}"
    resetprop --delete persist.dbg.ims_volte_enable 2>/dev/null
    resetprop --delete persist.dbg.volte_avail_ovr 2>/dev/null
    resetprop --delete persist.dbg.vt_avail_ovr 2>/dev/null
    resetprop --delete persist.dbg.wfc_avail_ovr 2>/dev/null
    setprop persist.radio.is_vonr_enabled_0 true
    setprop persist.radio.is_vonr_enabled_1 true

    echo -e "${CYAN}Updating SIM Info database...${RESET}"
    content update --uri content://telephony/siminfo \
        --bind volte_vt_enabled:i:1 \
        --bind video_calling_enabled:i:1 \
        --bind wfc_ims_enabled:i:1 \
        --bind wfc_ims_mode:i:2 \
        --bind wfc_ims_roaming_mode:i:2 \
        --bind wfc_ims_roaming_enabled:i:1 \
        --bind nr_advanced_calling_enabled:i:1 \
        --bind cross_sim_calling_enabled:i:1 >/dev/null 2>&1

    echo -e "${CYAN}Invoking CarrierConfig Applier binder injector...${RESET}"
    APPLIER_DEX="$MODDIR/system/bin/Applier.dex"
    if [ -f "$APPLIER_DEX" ]; then
        CLASSPATH="$APPLIER_DEX" app_process / Applier apply
    fi
    echo -e "${GREEN}Network fix reload complete!${RESET}"
}

dump_json() {
    MODEL=$(getprop ro.product.model)
    DEVICE=$(getprop ro.product.device)
    ANDROID_VER=$(getprop ro.build.version.release)
    SECURITY_PATCH=$(getprop ro.build.version.security_patch)

    CFG_ACTIVE="false"
    MOUNTED_CFG_INODE=$(ls -i /mnt/vendor/modem_img/images/*/confpack/cfg.db 2>/dev/null | head -n 1 | awk '{print $1}')
    [ -n "$MOUNTED_CFG_INODE" ] && CFG_ACTIVE="true"

    UE_ACTIVE="false"
    MOUNTED_UE_INODE=$(ls -i /mnt/vendor/modem_img/images/*/uecap/WILDCARD.binarypb 2>/dev/null | head -n 1 | awk '{print $1}')
    [ -n "$MOUNTED_UE_INODE" ] && UE_ACTIVE="true"

    STEALTH="true"
    if grep -E "data/adb|pixel_ru_network_fix" /proc/self/mountinfo >/dev/null 2>&1; then
        STEALTH="false"
    fi

    OPERATORS=$(getprop gsm.sim.operator.alpha)
    NUMERICS=$(getprop gsm.sim.operator.numeric)
    NETWORKS=$(getprop gsm.network.type)

    OP1="${OPERATORS%%,*}"
    [ "$OP1" = "$OPERATORS" ] && OP2="" || OP2="${OPERATORS#*,}"
    PLMN1="${NUMERICS%%,*}"
    [ "$PLMN1" = "$NUMERICS" ] && PLMN2="" || PLMN2="${NUMERICS#*,}"
    NET1="${NETWORKS%%,*}"
    [ "$NET1" = "$NETWORKS" ] && NET2="" || NET2="${NETWORKS#*,}"

    SOC_TEMP=""
    for t in /sys/class/thermal/thermal_zone*/type; do
        if [ "$(cat "$t" 2>/dev/null)" = "soc_therm" ]; then
            val=$(cat "${t%/*}/temp" 2>/dev/null)
            [ -n "$val" ] && SOC_TEMP=$((val / 1000))
            break
        fi
    done
    [ -z "$SOC_TEMP" ] && SOC_TEMP="0"

    PARSED_JSON=$(dumpsys telephony.registry 2>/dev/null | awk '
BEGIN {
    slot = -1;
    for (s=0; s<=1; s++) {
        rsrp[s]=""; rsrq[s]=""; sinr[s]=""; ta[s]="0"; cqi[s]="";
        bands[s]=""; bw[s]=""; earfcn[s]=""; ca[s]="false"; vops[s]="false";
        nr[s]="false"; dl[s]=0; ul[s]=0; iface[s]=""; pcscf[s]="";
        neigh_count[s]=0;
    }
}
/Phone Id=0/ { slot = 0; }
/Phone Id=1/ { slot = 1; }
slot >= 0 && /mLte=CellSignalStrengthLte:/ {
    for (i=1; i<=NF; i++) {
        split($i, kv, "=");
        if (kv[1]=="rsrp" && kv[2]!="2147483647") rsrp[slot]=kv[2];
        if (kv[1]=="rsrq" && kv[2]!="2147483647") rsrq[slot]=kv[2];
        if (kv[1]=="rssnr" && kv[2]!="2147483647") sinr[slot]=kv[2];
        if (kv[1]=="ta" && kv[2]!="2147483647") ta[slot]=kv[2];
        if (kv[1]=="cqi" && kv[2]!="2147483647") cqi[slot]=kv[2];
    }
}
slot >= 0 && /mBands=\[/ {
    idx = index($0, "mBands=[");
    if (idx > 0) {
        sub_str = substr($0, idx + 8);
        end_idx = index(sub_str, "]");
        bands[slot] = substr(sub_str, 1, end_idx - 1);
    }
}
slot >= 0 && /mCellBandwidths=\[/ {
    idx = index($0, "mCellBandwidths=[");
    if (idx > 0) {
        sub_str = substr($0, idx + 17);
        end_idx = index(sub_str, "]");
        bw[slot] = substr(sub_str, 1, end_idx - 1);
    }
}
slot >= 0 && /mChannelNumber=/ {
    idx = index($0, "mChannelNumber=");
    if (idx > 0) {
        sub_str = substr($0, idx + 15);
        split(sub_str, p, ",");
        earfcn[slot] = p[1];
    }
}
slot >= 0 && /isUsingCarrierAggregation=true/ { ca[slot] = "true"; }
slot >= 0 && /overrideNetwork=LTE_CA/ { ca[slot] = "true"; }
slot >= 0 && /mVopsSupport = 2/ { vops[slot] = "true"; }
slot >= 0 && /isNrAvailable = true/ { nr[slot] = "true"; }
slot >= 0 && /mDownlinkCapacityKbps=/ {
    idx = index($0, "mDownlinkCapacityKbps=");
    if (idx > 0 && dl[slot] == 0) {
        sub_str = substr($0, idx + 23);
        split(sub_str, p, ",");
        dl[slot] = p[1];
    }
    idx = index($0, "mUplinkCapacityKbps=");
    if (idx > 0 && ul[slot] == 0) {
        sub_str = substr($0, idx + 21);
        split(sub_str, p, "}");
        split(p[1], p2, ",");
        ul[slot] = p2[1];
    }
}
slot >= 0 && /InterfaceName: rmnet/ {
    idx = index($0, "InterfaceName: ");
    if (idx > 0) {
        sub_str = substr($0, idx + 15);
        split(sub_str, p, " ");
        iface[slot] = p[1];
    }
}
slot >= 0 && /P-CSCF addresses/ {
    idx = index($0, "P-CSCF addresses: [");
    if (idx > 0) {
        sub_str = substr($0, idx + 19);
        end_idx = index(sub_str, "]");
        pcscf[slot] = substr(sub_str, 1, end_idx - 1);
    }
}
slot >= 0 && /mCellInfo=\[/ && neigh_count[slot] == 0 {
    n = split($0, cells, "CellInfoLte:");
    for (i=2; i<=n; i++) {
        if (cells[i] ~ /mRegistered=NO/) {
            match(cells[i], /rsrp=[-0-9]+/);
            nr_rsrp = substr(cells[i], RSTART+5, RLENGTH-5);
            match(cells[i], /rsrq=[-0-9]+/);
            nr_rsrq = substr(cells[i], RSTART+5, RLENGTH-5);
            match(cells[i], /rssnr=[-0-9]+/);
            nr_sinr = substr(cells[i], RSTART+6, RLENGTH-6);
            if (nr_rsrp != "2147483647" && nr_rsrp != "") {
                if (nr_rsrq == "2147483647") nr_rsrq = "0";
                if (nr_sinr == "2147483647") nr_sinr = "0";
                idx_n = neigh_count[slot]++;
                if (idx_n < 8) {
                    neigh_json[slot, idx_n] = sprintf("{\"rsrp\":%s,\"rsrq\":%s,\"sinr\":%s}", nr_rsrp, nr_rsrq, nr_sinr);
                }
            }
        }
    }
}
END {
    for (s=0; s<=1; s++) {
        neigh_str = "[";
        for (k=0; k<neigh_count[s] && k<8; k++) {
            if (k > 0) neigh_str = neigh_str ",";
            neigh_str = neigh_str neigh_json[s, k];
        }
        neigh_str = neigh_str "]";
        printf "%d|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%d|%d|%s|%s|%s\n", \
            s, rsrp[s], rsrq[s], sinr[s], ta[s], cqi[s], bands[s], bw[s], earfcn[s], ca[s], vops[s], nr[s], dl[s], ul[s], iface[s], pcscf[s], neigh_str;
    }
}')

    echo "{"
    echo "  \"ok\": true,"
    echo "  \"model\": \"$MODEL\","
    echo "  \"device\": \"$DEVICE\","
    echo "  \"android\": \"$ANDROID_VER\","
    echo "  \"patch\": \"$SECURITY_PATCH\","
    echo "  \"temp\": $SOC_TEMP,"
    echo "  \"mounts\": {"
    echo "    \"cfg\": $CFG_ACTIVE,"
    echo "    \"cfg_inode\": \"$MOUNTED_CFG_INODE\","
    echo "    \"uecap\": $UE_ACTIVE,"
    echo "    \"uecap_inode\": \"$MOUNTED_UE_INODE\","
    echo "    \"stealth\": $STEALTH,"
    echo "    \"carrier_config\": true"
    echo "  },"
    echo "  \"sims\": ["

    first=1
    echo "$PARSED_JSON" | while IFS='|' read -r s r_rsrp r_rsrq r_sinr r_ta r_cqi r_bands r_bw r_earfcn r_ca r_vops r_nr r_dl r_ul r_iface r_pcscf r_neigh; do
        [ -z "$s" ] && continue
        [ "$first" -eq 0 ] && echo "    ,"
        first=0
        
        op="$OP1"; plmn="$PLMN1"; net="$NET1"; ims="true"
        [ "$s" -eq 1 ] && { op="$OP2"; plmn="$PLMN2"; net="$NET2"; }
        
        [ -z "$r_rsrp" ] && r_rsrp="-140"
        [ -z "$r_rsrq" ] && r_rsrq="0"
        [ -z "$r_sinr" ] && r_sinr="0"
        [ -z "$r_cqi" ] && r_cqi="0"
        [ -z "$r_ta" ] && r_ta="0"
        ta_dist=$((r_ta * 78))

        cat << S_EOF
    {
      "slot": $s,
      "op": "$op",
      "plmn": "$plmn",
      "net": "$net",
      "ims": $ims,
      "radio": {
        "rsrp": $r_rsrp,
        "rsrq": $r_rsrq,
        "sinr": $r_sinr,
        "ta": $r_ta,
        "ta_meters": $ta_dist,
        "cqi": $r_cqi,
        "bands": "$r_bands",
        "bw": "$r_bw",
        "earfcn": "$r_earfcn",
        "ca": $r_ca,
        "vops": $r_vops,
        "nr": $r_nr,
        "dlKbps": $r_dl,
        "ulKbps": $r_ul,
        "iface": "$r_iface",
        "pcscf": "$r_pcscf",
        "neighbors": $r_neigh
      }
    }
S_EOF
    done

    echo "  ]"
    echo "}"
}

case "$1" in
    json)
        dump_json
        ;;
    reload|apply)
        reload_fix
        ;;
    apn)
        provision_apns
        ;;
    help|-h|--help)
        echo "Usage: netfix [status|reload|apn|json|help]"
        echo "  status  - Show network, baseband mounts, and live telemetry (default)"
        echo "  reload  - Re-inject CarrierConfig and telephony properties"
        echo "  apn     - Auto-provision certified Russian MVNO APNs"
        echo "  json    - Output full system and telephony telemetry JSON for WebUI"
        ;;
    *)
        print_header
        check_modem_mounts
        check_telephony
        ;;
esac
