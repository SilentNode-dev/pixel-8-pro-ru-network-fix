#!/system/bin/sh
# Pixel Russian Networks & 5G/VoLTE Fix CLI Utility (netfix)
# Author: SilentNode-dev

MODDIR="/data/adb/modules/pixel_ru_network_fix"
[ ! -d "$MODDIR" ] && MODDIR="${0%/*}/../.."

# Colors
GREEN='\033[1;32m'
CYAN='\033[1;36m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
BOLD='\033[1m'
RESET='\033[0m'

print_header() {
    MODEL=$(getprop ro.product.model)
    DEVICE=$(getprop ro.product.device)
    ANDROID_VER=$(getprop ro.build.version.release)
    echo -e "${CYAN}======================================================${RESET}"
    echo -e "${BOLD} Pixel Network & 5G/VoLTE Fix (v1.2) - Status${RESET}"
    echo -e " Device: ${GREEN}$MODEL ($DEVICE)${RESET} | Android: ${GREEN}$ANDROID_VER${RESET}"
    echo -e "${CYAN}======================================================${RESET}"
}

check_modem_mounts() {
    echo -e "\n${BOLD}[ Modem Image & Baseband Bind-Mounts ]${RESET}"
    
    CFG_SRC="$MODDIR/confpack/cfg.db"
    UECAP_SRC="$MODDIR/uecap/WILDCARD.binarypb"
    
    if [ -f "$CFG_SRC" ]; then
        SRC_INODE=$(ls -i "$CFG_SRC" 2>/dev/null | awk '{print $1}')
        MOUNTED_INODE=$(ls -i /mnt/vendor/modem_img/images/*/confpack/cfg.db 2>/dev/null | head -n 1 | awk '{print $1}')
        if [ -n "$MOUNTED_INODE" ] && [ "$SRC_INODE" = "$MOUNTED_INODE" ]; then
            echo -e " Baseband cfg.db:      ${GREEN}ACTIVE${RESET} (inode: $MOUNTED_INODE, Shannon SER Donor)"
        else
            echo -e " Baseband cfg.db:      ${RED}NOT MOUNTED${RESET}"
        fi
    fi

    if [ -f "$UECAP_SRC" ]; then
        UE_SRC_INODE=$(ls -i "$UECAP_SRC" 2>/dev/null | awk '{print $1}')
        UE_MOUNTED_INODE=$(ls -i /mnt/vendor/modem_img/images/*/uecap/WILDCARD.binarypb 2>/dev/null | head -n 1 | awk '{print $1}')
        if [ -n "$UE_MOUNTED_INODE" ] && [ "$UE_SRC_INODE" = "$UE_MOUNTED_INODE" ]; then
            echo -e " Modem UE Capabilities:${GREEN}ACTIVE${RESET} (inode: $UE_MOUNTED_INODE, Wildcard CA/5G)"
        else
            echo -e " Modem UE Capabilities:${RED}NOT MOUNTED${RESET}"
        fi
    fi
}

check_telephony() {
    echo -e "\n${BOLD}[ Telephony & IMS Status ]${RESET}"
    
    APPLIER_DEX="$MODDIR/system/bin/Applier.dex"
    STATUS_JSON=""
    if [ -f "$APPLIER_DEX" ]; then
        STATUS_JSON=$(CLASSPATH="$APPLIER_DEX" app_process / Applier status 2>/dev/null)
    fi

    OPERATORS=$(getprop gsm.sim.operator.alpha)
    NUMERICS=$(getprop gsm.sim.operator.numeric)
    NETWORKS=$(getprop gsm.network.type)

    for slot in 0 1; do
        SLOT_NAME="SIM $((slot + 1))"
        OP_NAME=$(echo "$OPERATORS" | awk -F',' -v s=$((slot + 1)) '{print $s}')
        PLMN=$(echo "$NUMERICS" | awk -F',' -v s=$((slot + 1)) '{print $s}')
        NET_TYPE=$(echo "$NETWORKS" | awk -F',' -v s=$((slot + 1)) '{print $s}')

        [ -z "$OP_NAME" ] && OP_NAME="Slot Empty / Inactive"
        [ -z "$PLMN" ] && PLMN="N/A"
        [ -z "$NET_TYPE" ] && NET_TYPE="Unknown"

        echo -e " ${BOLD}$SLOT_NAME:${RESET} ${CYAN}$OP_NAME${RESET} (PLMN: $PLMN | Network: $NET_TYPE)"

        # Check IMS status from Applier
        IMS_REG=false
        if echo "$STATUS_JSON" | grep -q "\"slotIndex\":$slot.*\"imsRegistered\":true"; then
            IMS_REG=true
        fi

        if [ "$IMS_REG" = "true" ]; then
            echo -e "   VoLTE / VoWiFi IMS: ${GREEN}REGISTERED (Active)${RESET}"
        else
            echo -e "   VoLTE / VoWiFi IMS: ${YELLOW}UNREGISTERED / STANDBY${RESET}"
        fi

        # Check Voice Over Packet Switch (VoPS) and 5G availability from dumpsys
        DUMP=$(dumpsys telephony.registry 2>/dev/null | grep -A 10 "mSlotIndex=$slot")
        if echo "$DUMP" | grep -q "mVoLte=true\|VoPS=2"; then
            echo -e "   VoLTE Support:      ${GREEN}SUPPORTED${RESET}"
        fi
        if echo "$DUMP" | grep -q "NrFrequencyRange\|nrAvailable=true"; then
            echo -e "   5G NR / VoNR:       ${GREEN}AVAILABLE (n78/n79/DSS)${RESET}"
        fi
        echo ""
    done
}

provision_apns() {
    echo -e "${CYAN}Checking Russian MVNO & Carrier APNs...${RESET}"
    ALL_APNS=$(content query --uri content://telephony/carriers --projection numeric:apn 2>/dev/null)

    add_apn_if_missing() {
        NAME="$1"; NUM="$2"; APN="$3"; TYPE="$4"
        if ! echo "$ALL_APNS" | grep -q "numeric=$NUM, apn=$APN"; then
            echo -e " Adding missing APN for ${YELLOW}$NAME${RESET} ($NUM -> $APN)..."
            content insert --uri content://telephony/carriers \
                --bind name:s:"$NAME" \
                --bind numeric:s:"$NUM" \
                --bind mcc:s:"${NUM:0:3}" \
                --bind mnc:s:"${NUM:3}" \
                --bind apn:s:"$APN" \
                --bind type:s:"$TYPE" \
                --bind current:i:1 >/dev/null 2>&1
        fi
    }

    # Certified APN list for RU carriers and MVNOs
    add_apn_if_missing "Yota Internet" "25002" "internet.yota" "default,supl"
    add_apn_if_missing "Yota Internet" "25011" "internet.yota" "default,supl"
    add_apn_if_missing "SberMobile" "25020" "sbermobile.ru" "default,supl,dun"
    add_apn_if_missing "T-Bank Internet" "25020" "m.tinkoff" "default,supl,dun"
    add_apn_if_missing "GPB Mobile" "25045" "internet.gpbm.ru" "default,supl"
    add_apn_if_missing "VTB Mobile" "25020" "internet.vtb.ru" "default,supl"
    add_apn_if_missing "Motiv Internet" "25035" "inet.ycc.ru" "default,supl"
    add_apn_if_missing "Letai Internet" "25027" "internet.letai.ru" "default,supl"
    add_apn_if_missing "T2 Internet" "25020" "internet.tele2.ru" "default,supl"
    
    echo -e "${GREEN}APN check complete.${RESET}"
}

reload_fix() {
    echo -e "${CYAN}Applying persistent telephony properties...${RESET}"
    setprop persist.dbg.ims_volte_enable 1
    setprop persist.dbg.volte_avail_ovr 1
    setprop persist.dbg.vt_avail_ovr 1
    setprop persist.dbg.wfc_avail_ovr 1
    setprop persist.radio.is_vonr_enabled_0 true
    setprop persist.radio.is_vonr_enabled_1 true

    echo -e "${CYAN}Updating SIM Info database...${RESET}"
    content update --uri content://telephony/siminfo \
        --bind volte_vt_enabled:i:1 \
        --bind video_calling_enabled:i:1 \
        --bind wfc_ims_enabled:i:1 \
        --bind wfc_ims_mode:i:2 \
        --bind wfc_ims_roaming_mode:i:2 \
        --bind wfc_ims_roaming_enabled:i:1 \
        --bind nr_advanced_calling_enabled:i:1 \
        --bind cross_sim_calling_enabled:i:1 2>/dev/null

    provision_apns

    echo -e "${CYAN}Executing Binder Applier...${RESET}"
    APPLIER_DEX="$MODDIR/system/bin/Applier.dex"
    if [ -f "$APPLIER_DEX" ]; then
        RES=$(CLASSPATH="$APPLIER_DEX" app_process / Applier apply 2>/dev/null)
        echo -e " Applier result: ${GREEN}$RES${RESET}"
    fi

    echo -e "${GREEN}Fix reloaded successfully!${RESET}"
}

show_logs() {
    echo -e "${CYAN}=== Live Radio, Modem & IMS Logs ===${RESET}"
    LOGS=$(logcat -d -b radio -b main | grep -E -i "shannon|ims|carrier|volte|vowifi|applier|5g" | tail -n 80)
    if [ -n "$LOGS" ]; then
        echo "$LOGS"
    else
        logcat -d -b radio -b main | tail -n 60
    fi
}

dump_json() {
    MODEL=$(getprop ro.product.model)
    DEVICE=$(getprop ro.product.device)
    ANDROID_VER=$(getprop ro.build.version.release)
    SECURITY_PATCH=$(getprop ro.build.version.security_patch)

    CFG_SRC="$MODDIR/confpack/cfg.db"
    UECAP_SRC="$MODDIR/uecap/WILDCARD.binarypb"
    
    CFG_ACTIVE="false"
    if [ -f "$CFG_SRC" ]; then
        SRC_INODE=$(ls -i "$CFG_SRC" 2>/dev/null | awk '{print $1}')
        MOUNTED_INODE=$(ls -i /mnt/vendor/modem_img/images/*/confpack/cfg.db 2>/dev/null | head -n 1 | awk '{print $1}')
        [ -n "$MOUNTED_INODE" ] && [ "$SRC_INODE" = "$MOUNTED_INODE" ] && CFG_ACTIVE="true"
    fi

    UE_ACTIVE="false"
    if [ -f "$UECAP_SRC" ]; then
        UE_SRC_INODE=$(ls -i "$UECAP_SRC" 2>/dev/null | awk '{print $1}')
        UE_MOUNTED_INODE=$(ls -i /mnt/vendor/modem_img/images/*/uecap/WILDCARD.binarypb 2>/dev/null | head -n 1 | awk '{print $1}')
        [ -n "$UE_MOUNTED_INODE" ] && [ "$UE_SRC_INODE" = "$UE_MOUNTED_INODE" ] && UE_ACTIVE="true"
    fi

    OPERATORS=$(getprop gsm.sim.operator.alpha)
    NUMERICS=$(getprop gsm.sim.operator.numeric)
    NETWORKS=$(getprop gsm.network.type)

    OP1="${OPERATORS%%,*}"
    [ "$OP1" = "$OPERATORS" ] && OP2="" || OP2="${OPERATORS#*,}"
    PLMN1="${NUMERICS%%,*}"
    [ "$PLMN1" = "$NUMERICS" ] && PLMN2="" || PLMN2="${NUMERICS#*,}"
    NET1="${NETWORKS%%,*}"
    [ "$NET1" = "$NETWORKS" ] && NET2="" || NET2="${NETWORKS#*,}"

    # IMS registration check via dumpsys notifyDataConnection
    REG_DUMP=$(dumpsys telephony.registry 2>/dev/null)
    IMS1="false"
    IMS2="false"
    echo "$REG_DUMP" | grep "phoneId=0" | grep "ims" | tail -n 1 | grep -q "CONNECTED" && IMS1="true"
    echo "$REG_DUMP" | grep "phoneId=1" | grep "ims" | tail -n 1 | grep -q "CONNECTED" && IMS2="true"

    CFG_CONTENT="{}"
    [ -f "/data/adb/carrier_ims/config.json" ] && CFG_CONTENT=$(cat /data/adb/carrier_ims/config.json 2>/dev/null)
    [ -z "$CFG_CONTENT" ] && CFG_CONTENT="{}"

    echo "{\"ok\":true,\"model\":\"$MODEL\",\"device\":\"$DEVICE\",\"android\":\"$ANDROID_VER\",\"patch\":\"$SECURITY_PATCH\",\"mounts\":{\"cfg\":$CFG_ACTIVE,\"uecap\":$UE_ACTIVE},\"sims\":[{\"slot\":0,\"op\":\"$OP1\",\"plmn\":\"$PLMN1\",\"net\":\"$NET1\",\"ims\":$IMS1},{\"slot\":1,\"op\":\"$OP2\",\"plmn\":\"$PLMN2\",\"net\":\"$NET2\",\"ims\":$IMS2}],\"config\":$CFG_CONTENT}"
}

case "$1" in
    json)
        dump_json
        ;;
    reload|apply)
        reload_fix
        ;;
    apn)
        provision_apns
        ;;
    log|logs)
        show_logs
        ;;
    help|-h|--help)
        echo "Usage: netfix [status|reload|apn|log|json|help]"
        echo "  status  - Show network, IMS, baseband mounts, and 5G status (default)"
        echo "  reload  - Re-inject CarrierConfig and telephony properties without reboot"
        echo "  apn     - Auto-provision certified Russian MVNO and carrier APNs"
        echo "  log     - Show recent IMS and radio logcat entries"
        echo "  json    - Output full system and telephony status in one compact JSON"
        ;;
    *)
        print_header
        check_modem_mounts
        check_telephony
        ;;
esac
